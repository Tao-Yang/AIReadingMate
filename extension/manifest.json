{
  "manifest_version": 3,
  "name": "阅读伴侣 · PDF Reading Companion",
  "version": "1.0.0",
  "description": "点击图标唤出小机器人伴读，对浏览器中打开的 PDF 划词即得中文注释。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "唤出/收起阅读伴侣机器人",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["scripting", "activeTab", "clipboardRead"],
  "host_permissions": [
    "https://ai-reading-mate.onrender.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["vendor/three.min.js", "robot.js", "overlay.css", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
